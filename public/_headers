# Cloudflare Pages yanıt başlıkları (2026-11-15; önceden next.config headers()).
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Dışa aktarılan OG görseli uzantısız dosya; türü belirtilmezse
# application/octet-stream gidiyor ve sosyal önizlemeler görseli reddediyor.
/:locale/opengraph-image
  Content-Type: image/png

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
